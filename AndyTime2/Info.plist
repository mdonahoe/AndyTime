<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Used to stream the front camera over LiveKit WebRTC</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to capture audio for LiveKit WebRTC streaming</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to connect to a local LiveKit server on the same network</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_livekit._tcp</string>
	</array>
</dict>
</plist>
